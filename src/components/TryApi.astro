---
const remote = import.meta.env.PUBLIC_API_URL?.trim().replace(/\/+$/, '');
const endpoints = [
  ['Projetos', 'projects'], ['Perfil', 'profile'], ['Stack', 'skills'],
].map(([name, resource]) => ({name, url: remote ? `${remote}/api/v1/${resource}` : `${import.meta.env.BASE_URL}api/v1/${resource}.json`}));
---
<section class="try playground" id="api" aria-label="Backend Playground">
  <div class="q">Backend <i>Playground</i><p class="mono">{remote ? 'API FastAPI externa · requisições HTTP' : 'JSON estático publicado com Astro · HTTP real, sem servidor FastAPI'}</p>{remote && <a class="link api-docs" href={remote + '/docs'}>Swagger ↗</a>}</div>
  <div class="api-console">
    <div class="inp"><span><b>GET</b> <select id="api-path" aria-label="Endpoint">
      {endpoints.map(({name,url}) => <option value={url}>{name} · {url}</option>)}
    </select></span><button class="go" id="api-go" type="button">enviar ↵</button></div>
    <pre class="out" id="api-out" aria-live="polite">Aguardando consulta.</pre>
  </div>
</section>
<script>
  const btn = document.getElementById('api-go') as HTMLButtonElement | null;
  const out = document.getElementById('api-out');
  const path = document.getElementById('api-path') as HTMLSelectElement | null;
  btn?.addEventListener('click', async () => {
    if (!out || !path || !btn) return;
    btn.disabled = true;
    out.textContent = 'Consultando…';
    const t0 = performance.now();
    try {
      const res = await fetch(path.value, { headers: { Accept: 'application/json' }, signal: AbortSignal.timeout(10000) });
      const body = await res.text();
      let pretty = body;
      try { pretty = JSON.stringify(JSON.parse(body), null, 2); } catch {}
      out.textContent = `${res.status} ${res.statusText} · ${Math.round(performance.now() - t0)}ms\n${pretty}`;
    } catch { out.textContent = 'Falha na consulta. Tente novamente.'; }
    finally { btn.disabled = false; }
  });
</script>
