---
import { projects } from '../data/projects';

const stageSpec = projects.map((p) => ({
  monitor: p.monitor,
  laptop: p.laptop,
  phone: p.phone,
  labels: p.labels.map((l) => [l.html, l.pos]),
}));
const engineering: Record<string, string> = {"jas-easy-path": "Motor em Python com OR-Tools para ordenar entregas considerando capacidade e janelas de tempo. A API integra o cálculo ao fluxo da aplicação; testes validam sequência, restrições e retorno ao depósito. Projeto em desenvolvimento.", "fundec-rs": "Pipeline ETL em Python e pandas, modelo estrela em SQLite e dashboards Qlik. Análise da distribuição, cobertura e velocidade dos repasses após as enchentes. Resultado: 2º lugar nacional e 23 testes.", "postais-parnaiba": "Acervo para um historiador, com API REST, autenticação JWT, CRUD administrativo, PostgreSQL e migrações Alembic. MVP com site público e painel de conteúdo.", "beckglobal": "Base reutilizável de APIs com FastAPI, SQLAlchemy, Pydantic, migrações Alembic e Docker Compose. Protótipo para padronizar estrutura, autenticação e testes."};
const info = projects.map((p) => [p.now, p.what]);
---

<div class="sec" id="trabalhos">
  <h2>Trabalhos<br /><i>selecionados</i></h2>
  <p class="mono">quatro projetos · capturas e notas de engenharia</p>
</div>

<section class="sx static-stage">
  <nav class="static-nav mono" aria-label="Projetos selecionados">
    {projects.map(p => <a href={`#${p.id}`}>{p.no} {p.navLabel}</a>)}
  </nav>
  <div class="sx-l">
    {projects.map((p, i) => (
      <article class="blk" id={p.id} data-i={i}>
        <div class="vis-m">
          {p.fallbackImg
            ? <a href={p.fallbackImg} target="_blank" rel="noopener">
                <template><img src={p.fallbackImg} alt={p.fallbackAlt} decoding="async" /></template>
                <noscript><img src={p.fallbackImg} alt={p.fallbackAlt} loading="lazy" decoding="async" /></noscript>
                <span>Ampliar captura ↗</span>
              </a>
            : <pre aria-label={p.fallbackAlt}><code>{`# app/api/users.py\n@router.post("/users/", status_code=201)\n…\nuser.password = bcrypt.hash(data.password)\ndb.add(user)\ndb.commit()`}</code></pre>}
        </div>
        <div class="bno"><span>{p.no}</span><em class="mono">/ 04</em></div>
        <div class="k">{p.kicker}</div>
        <h3 set:html={p.title}></h3>
        <p class="lead">{p.lead}</p>
        <dl>
          {p.dl.map(([dt, dd]) => (<><dt>{dt}</dt><dd>{dd}</dd></>))}
        </dl>
        <div class="rs">
          {p.metrics.map(([b, s]) => (<div><b>{b}</b><span>{s}</span></div>))}
        </div>
        <div class="project-actions">
          <a class="btn" href={p.url}>{p.id === "fundec-rs" ? "Ler relatório" : "Ver projeto no GitHub"} <b>→</b></a>
          {p.id === 'fundec-rs' && <a class="link" href="https://github.com/Nalan27/Hackaton-Excelsior-/">Código-fonte ↗</a>}
        </div>
        <details class="engineering">
          <summary>Explorar engenharia do projeto</summary>
          <p>{engineering[p.id]}</p>
          <div class="project-shots">
            {[p.monitor, p.laptop, p.phone].filter((src): src is string => Boolean(src) && src !== 'code()' && src !== 'docs()').map((src, i) => (
              <a href={src} target="_blank" rel="noopener" aria-label={`Abrir captura ${i + 1} em tamanho original`}><img src={src} alt={`Captura ${i + 1} de ${p.now}`} loading="lazy" decoding="async" /><span>Ampliar ↗</span></a>
            ))}
          </div>
        </details>
      </article>
    ))}
  </div>

  <div class="sx-r">
    <div class="stg">
      <div id="stage" aria-hidden="true"></div>
      <div class="top mono">
        <span>agora: <b id="now">{projects[0].now}</b></span>
        <span id="what">{projects[0].what}</span>
      </div>
      <div class="nav mono" role="group" aria-label="projetos">
        {projects.map((p, i) => (
          <button class:list={['n', { on: i === 0 }]} data-i={i} type="button">
            <i aria-hidden="true"><u></u></i>
            <span><b>{p.no}</b> {p.navLabel}</span>
          </button>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .static-nav {display:flex;flex-wrap:wrap;gap:0 1rem}
  .sx:not(.static-stage) .static-nav {display:none}
  .static-nav a,.project-actions a {display:inline-flex;align-items:center;min-height:44px}
  .engineering summary {min-height:44px;padding-block:12px}
  .nav button {min-height:44px;text-align:left;color:inherit;font:inherit;background:none;border:0;padding:0}
  .sx .blk .vis-m {width:min(100%,680px);aspect-ratio:auto;margin-bottom:24px;background:var(--soft);border-radius:6px;overflow:hidden}
  .vis-m a {display:block}
  .sx .blk .vis-m img {display:block;width:100%;height:auto}
  .vis-m span {display:block;padding:8px 12px;font:0.8rem monospace}
  .vis-m pre {margin:0;padding:1rem;background:#171717;color:#fafafa;white-space:pre-wrap;overflow-wrap:anywhere;font:0.95rem/1.6 monospace}
  @media (width < 1024px) {
    .sx {display:flex;flex-direction:column}
    .sx-l {order:2}
    .sx:not(.static-stage) .sx-r {order:1;display:block;position:relative;height:clamp(290px,56svh,480px);padding:12px 0 0}
    .stg #stage{inset:30px 0 94px;touch-action:pan-y pinch-zoom}
    .stg .top{inset:10px 12px auto;flex-wrap:wrap;gap:2px 10px;font-size:10px}
    .stg .nav{inset:auto 12px 4px;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 12px}
    .stg .n i{margin-bottom:4px}
    .stg :global(.lbl){display:none}
    .sx:not(.static-stage) .blk:not(.selected), .sx:not(.static-stage) .vis-m {display:none}
    .project-shots {grid-template-columns:repeat(auto-fit,minmax(min(100%,15rem),1fr))}
    .project-shots img {height:auto;max-height:22rem}
  }
</style>

<script type="application/json" id="stage-spec" set:html={JSON.stringify(stageSpec)}></script>
<script type="application/json" id="stage-info" set:html={JSON.stringify(info)}></script>

<script>
  import type { StageCtl, ProjectSpec } from '../three/devices';

  type SpecEntry = ProjectSpec;

  const specEl = document.getElementById('stage-spec');
  const infoEl = document.getElementById('stage-info');
  const spec: SpecEntry[] = specEl ? JSON.parse(specEl.textContent ?? '[]') : [];
  const info: [string, string][] = infoEl ? JSON.parse(infoEl.textContent ?? '[]') : [];

  const blks = [...document.querySelectorAll<HTMLElement>('.blk')];
  const ns = [...document.querySelectorAll<HTMLElement>('.n')];
  const nowEl = document.getElementById('now');
  const whatEl = document.getElementById('what');
  const stageEl = document.getElementById('stage');

  let st: StageCtl | null = null;
  let act = 0;
  const desktop = matchMedia('(min-width: 1024px)');
  function select(i: number) {
    act = i;
    st?.set(i);
    blks.forEach((b, j) => b.classList.toggle('selected', j === i));
    ns.forEach((n, j) => { n.classList.toggle('on', j === i); n.setAttribute('aria-pressed', String(j === i)); });
    if (nowEl) nowEl.textContent = info[i]?.[0] ?? '';
    if (whatEl) whatEl.textContent = info[i]?.[1] ?? '';
  }

  // O lazy nativo antecipa PNGs a várias telas de distância; o template não inicia download.
  const previews = new IntersectionObserver((entries) => {
    for (const entry of entries) {
      if (!entry.isIntersecting) continue;
      const template = entry.target.querySelector('template');
      if (template) template.replaceWith(template.content);
      previews.unobserve(entry.target);
    }
  }, { rootMargin: '200px 0px' });
  document.querySelectorAll('.vis-m a').forEach(link => previews.observe(link));

  function onScroll() {
    if (!desktop.matches || !st || !stageEl?.clientWidth) return;
    const mid = innerHeight / 2;
    let a = 0;
    blks.forEach((b, i) => {
      const r = b.getBoundingClientRect();
      if (r.top < mid) a = i;
      const f = Math.min(1, Math.max(0, (mid - r.top) / r.height));
      const u = ns[i]?.querySelector('u') as HTMLElement | null;
      if (u) u.style.width = f * 100 + '%';
    });
    if (a !== act) select(a);
  }

  // O navegador pode emitir scroll ao reancorar o documento durante o resize.
  let layoutFrame = 0;
  addEventListener('resize', () => {
    cancelAnimationFrame(layoutFrame);
    layoutFrame = requestAnimationFrame(() => {
      layoutFrame = requestAnimationFrame(() => { layoutFrame = 0; });
    });
  });
  addEventListener('scroll', () => { if (!layoutFrame) onScroll(); }, { passive: true });

  function selectAnchor() {
    const i = blks.findIndex(b => '#' + b.id === location.hash);
    if (i >= 0) select(i);
  }
  selectAnchor();
  addEventListener('hashchange', selectAnchor);

  // nav: clique rola até o bloco
  ns.forEach((n) => {
    const go = () => {
      const i = Number(n.dataset.i);
      select(i);
      if (desktop.matches) blks[i]?.scrollIntoView({ behavior: 'instant', block: 'center' });
    };
    n.addEventListener('click', go);
  });

  // Three.js só quando o palco entra na viewport
  if (stageEl) {
    const section = stageEl.closest('.sx')!;
    let lost = false;
    stageEl.addEventListener('webglcontextlost', () => {
      lost = true;
      st = null;
      section.classList.add('static-stage');
    }, true);
    const io = new IntersectionObserver(async ([entry]) => {
      if (!entry.isIntersecting) return;
      io.disconnect();
      try {
        const { stage } = await import('../three/devices');
        const controller = await stage(stageEl, spec);
        if (lost) return;
        st = controller;
        select(act);
        st.jump(act);
        section.classList.remove('static-stage');
      } catch { stageEl.replaceChildren(); }
    }, { rootMargin: '200px' });
    io.observe(section);
  }
</script>
