---
import Base from '../layouts/Base.astro';
import Meta from '../components/Meta.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import TryApi from '../components/TryApi.astro';
import Works from '../components/Works.astro';
import Studies from '../components/Studies.astro';
import About from '../components/About.astro';
import Footer from '../components/Footer.astro';
---

<Base>
  <Meta />
  <main>
    <Hero />
    <Marquee />
    <Works />
    <TryApi />
    <Studies />
    <About />
  </main>
  <Footer />
</Base>

<script>
  // cubo do hero: Three.js só quando entra na viewport
  const cubeEl = document.getElementById('cube');
  if (cubeEl) {
    const io = new IntersectionObserver(async (entries) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      io.disconnect();
      await document.fonts.ready;
      const { dataCube } = await import('../three/dataCube');
      try { dataCube(cubeEl, {
        cube: 0xeeeeea,
        line: 0x0d0d0d,
        accent: 0x2b50ff,
        labels: [
          ['<b>●</b> fundec-rs', [2.6, 2.6, 0.5]],
          ['PostgreSQL', [-3.4, -2.2, 1]],
        ],
      }); } catch { /* sem WebGL */ }
    }, { rootMargin: '200px' });
    io.observe(cubeEl);
  }
</script>
